# ============================================================
# Sisyphus Environment Variables (local cluster)
# Copy to .env.sisyphus and fill in actual values.
# Values are substituted into deployment/sisyphus-api/*.yaml and
# deployment/sisyphus-web/*.yaml via envsubst at apply time.
#
# Sisyphus shares the `ornn-cluster` namespace with the ornn local cluster.
# Deploy ornn first (chrono-ornn repo) so mongodb / minio / nyxid-backend /
# nyxid-frontend / chrono-storage / ornn-api are already in the namespace;
# sisyphus then references them by Service name.
# ============================================================

# -- Kubernetes (shared with ornn) --
NAMESPACE=ornn-cluster
IMAGE_PULL_POLICY=Never
# minio Service ClusterIP — ornn already created it. Used as a hostAlias so
# sisyphus-api (papers compile fetches PDFs via presigned URLs from
# chrono-storage) resolves `minio.ornn-cluster.local` to the same target the
# browser does.
#   kubectl get svc minio -n ornn-cluster -o jsonpath='{.spec.clusterIP}'
MINIO_HOST_ALIAS_IP=

# -- sisyphus-api --
SISYPHUS_API_IMAGE=sisyphus-api:latest
SISYPHUS_API_PORT=8080
SISYPHUS_DB_NAME=sisyphus
# Single MongoDB connection. Reuse the ornn-deployed mongodb Service:
#   mongodb://<root-user>:<root-pass>@mongodb:27017/sisyphus?authSource=admin
SISYPHUS_MONGO_URI=

# chrono-graph (sisyphus-only; deployed via deployment/dependencies/chrono-graph)
CHRONO_GRAPH_URL=http://chrono-graph:8080
SISYPHUS_GRAPH_ID=

# chrono-storage (ornn-deployed; reuse the existing Service)
CHRONO_STORAGE_URL=http://chrono-storage:3805
SISYPHUS_STORAGE_BUCKET=sisyphus-papers

# ornn-api / chrono-ornn skill prompt server (ornn-deployed; the in-cluster
# Service is `ornn-api` per the chrono-ornn repo)
CHRONO_ORNN_URL=http://ornn-api:3802

# Aevatar (external — runner exec + workflows deploy). Point at whichever
# Aevatar instance your local cluster should integrate with; leave blank if
# you don't intend to exercise /runs/* or /workflows/deploy.
AEVATAR_API_URL=
SISYPHUS_SCOPE_ID=

# Runner verify cron + event log retention
SISYPHUS_VERIFY_CRON_INTERVAL_HOURS=6
SISYPHUS_EVENT_TTL_DAYS=30

# -- sisyphus-web --
# Note: sisyphus-web bakes VITE_* env vars at `vite build` time.
# Make sure sisyphus-web/.env (with VITE_NYXID_* + VITE_AEVATAR_API_URL)
# is populated BEFORE building the image. Each environment needs its own
# image build; the manifest just selects an image.
SISYPHUS_WEB_IMAGE=sisyphus-web:latest
