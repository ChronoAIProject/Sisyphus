# ============================================================
# Sisyphus Local-Cluster Dependency Environment Variables
# Copy to .env.dependencies and fill in actual values.
#
# Sisyphus shares the `ornn-cluster` namespace with the ornn local cluster,
# so most dependency services (mongodb, minio, nyxid-backend, nyxid-frontend,
# chrono-storage, ornn-api) are already deployed by chrono-ornn — sisyphus
# only adds chrono-graph on top.
# ============================================================

# -- Kubernetes (shared with ornn) --
NAMESPACE=ornn-cluster
IMAGE_PULL_POLICY=Never

# -- chrono-graph (sisyphus-only; Neo4j-backed knowledge graph) --
# Image is built from your local chrono-graph checkout.
CHRONO_GRAPH_IMAGE=chrono-graph:latest
# Bring your own Neo4j (Aura, self-hosted, or a separate in-cluster pod).
# Bolt URI, e.g. neo4j+s://abcdef.databases.neo4j.io
NEO4J_URI=
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
