# Copy to .env and fill in real values
# Env vars consumed at runtime by sisyphus-api

# --- HTTP server ---
PORT=8080

# --- MongoDB (single DB for all six domains) ---
MONGO_URI=mongodb://localhost:27017
DB_NAME=sisyphus

# --- chrono-graph (used by ingest, runner) ---
CHRONO_GRAPH_URL=http://localhost:3000
GRAPH_ID=

# --- chrono-storage (used by papers compile output) ---
CHRONO_STORAGE_URL=http://localhost:3805
STORAGE_BUCKET=sisyphus-papers

# --- chrono-ornn skill prompts (used by workflows compile) ---
CHRONO_ORNN_URL=http://localhost:3001
ORNN_API_URL=http://localhost:3802

# --- Aevatar mainnet (used by runner + workflows deploy) ---
AEVATAR_API_URL=http://localhost:6688
AEVATAR_MAINNET_URL=http://localhost:6688
SCOPE_ID=76fe9d91-1f1d-4234-9352-819a7c28f709

# --- Internal references (carried over from the pre-merge microservices;
#     point at this same API while both endpoints still go through HTTP). ---
WORKFLOW_SERVICE_URL=http://localhost:8080
SCHEMA_SERVICE_URL=http://localhost:8080

# --- Runner verify cron + event log retention ---
VERIFY_CRON_INTERVAL_HOURS=6
EVENT_TTL_DAYS=30
