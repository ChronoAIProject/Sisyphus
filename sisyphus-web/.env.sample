# Copy to .env and fill in real values
# All Vite env vars must be prefixed with VITE_ to be exposed to the browser.

# NyxID auth + proxy. The browser hits NYXID_PROXY_URL/api/v1/proxy/s/sisyphus-api/<path>
# which NyxID then forwards (with the bearer token) to sisyphus-api.
VITE_NYXID_PROXY_URL=https://proxy.nyxid.io
VITE_NYXID_BASE_URL=https://auth.nyxid.io
VITE_NYXID_CLIENT_ID=

# Aevatar mainnet API — used directly from the browser for some workflow run ops.
VITE_AEVATAR_API_URL=https://mainnet.aevatar.ai

# Optional: pre-fill a default chrono-graph ID so users don't have to enter it manually.
VITE_DEFAULT_GRAPH_ID=
